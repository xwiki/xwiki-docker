 {
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  // Both .github/workflows/docker-build.yml and the docker-compose.yml files under the version directories are
  // generated (from template-github/ and template/ respectively). Updating a generated file directly produces a
  // Pull Request that the Gradlew Check action rejects and that the next './gradlew' run reverts, so the rules
  // below keep Renovate away from those files and point it at the template instead.
  "customManagers": [
    {
      // The action versions of the workflow template, which the native github-actions manager cannot read since
      // the template is not valid YAML before the tokens are expanded.
      "customType": "regex",
      "managerFilePatterns": [
        "/^template-github/.+\\.yml$/"
      ],
      "matchStrings": [
        "uses:\\s+(?<depName>[^\\s@]+)@(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      // The same versioning as the native github-actions manager, so that a 'v4' pin becomes 'v7' rather than 'v7.0.1'.
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      // The generated files. The database images of the generated docker-compose.yml files track their "latest"
      // tag, so there is no version pin for a custom manager to read out of template/docker-compose.yml in
      // exchange -- unlike the workflow template above.
      "matchFileNames": [
        ".github/workflows/docker-build.yml",
        "*/*/docker-compose.yml"
      ],
      "enabled": false
    }
  ]
}
